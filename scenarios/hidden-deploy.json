{
  "name": "hidden-deploy",
  "description": "payment-api 배포 후 처리 용량 저하. payment-api 에는 경보가 없어 checkout-api 가 먼저 울린다. 5초 뒤 inventory-api 배포는 함정",
  "startAt": "2026-01-01T00:00:00Z",
  "durationSec": 180,
  "tickSec": 5,
  "entry": "checkout-api",
  "loadRps": 80,
  "alertP99Ms": 500,
  "services": [
    {
      "name": "checkout-api",
      "capacityRps": 200,
      "baseLatencyMs": 30,
      "dependsOn": [
        "payment-api",
        "inventory-api"
      ],
      "timeoutMs": 400,
      "alertP99Ms": 700,
      "noiseLogRate": 0.1
    },
    {
      "name": "payment-api",
      "capacityRps": 120,
      "baseLatencyMs": 40,
      "dependsOn": [
        "payment-db"
      ],
      "timeoutMs": 300,
      "noiseLogRate": 0.1,
      "alertP99Ms": 100000
    },
    {
      "name": "inventory-api",
      "capacityRps": 300,
      "baseLatencyMs": 20,
      "noiseLogRate": 0.1
    },
    {
      "name": "payment-db",
      "capacityRps": 400,
      "baseLatencyMs": 8
    }
  ],
  "faults": [
    {
      "atSec": 60,
      "service": "payment-api",
      "kind": "deploy",
      "version": "v1.4.2",
      "capacityFactor": 0.72
    },
    {
      "atSec": 65,
      "service": "inventory-api",
      "kind": "deploy",
      "version": "v2.8.0",
      "capacityFactor": 1
    }
  ],
  "rootCause": {
    "service": "payment-api",
    "kind": "deploy",
    "atSec": 60
  }
}
