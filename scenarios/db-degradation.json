  "faults": [
    { "atSec": 65, "service": "checkout-api", "kind": "deploy", "version": "v3.1.0", "capacityFactor": 1 },
    { "atSec": 70, "service": "payment-db", "kind": "degrade", "capacityFactor": 0.21 }
