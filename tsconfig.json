{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "skipLibCheck": true
  },
  "include": ["src", "test", "vite.config.ts"]
}
