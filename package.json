{
  "name": "signal-desk",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "simulate": "node src/simulator/cli.ts",
    "dev:server": "node --watch --env-file-if-exists=.env.local src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "eval": "node --env-file=.env.local src/agent/eval.ts",
    "mcp": "node src/mcp/server.ts",
    "eval:rca": "node --env-file=.env.local src/rcaeval/eval.ts",
    "build:demo": "node scripts/build-demo.ts && VITE_DEMO=1 vite build --base /signal-desk/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@tanstack/react-virtual": "3.14.26",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
